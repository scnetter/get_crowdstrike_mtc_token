# CrowdStrike Falcon API credentials (OAuth2 client credentials)
# Copy to .env and replace placeholders:
#   cp .env.example .env

# WARNING: Do not commit your .env file to version control! Use .gitignore to ignore it.

# Replace with your actual credentials
CROWDSTRIKE_CLIENT_ID=YOUR_CLIENT_ID
CROWDSTRIKE_CLIENT_SECRET=YOUR_CLIENT_SECRET
# API base URL for your Falcon cloud (US-2 shown; use your tenant's host if different)
CROWDSTRIKE_BASE_URL=https://api.us-2.crowdstrike.com
